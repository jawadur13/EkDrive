{
  "name": "ekdrive-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --sourcemap --outfile=dist/index.js",
    "start": "node --enable-source-maps dist/index.js",
    "test": "vitest run",
    "lint": "eslint src/",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../.env.local -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e ../.env.local -- prisma migrate dev",
    "db:studio": "dotenv -e ../.env.local -- prisma studio",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@prisma/client": "^6.16.0",
    "bullmq": "^5.14.0",
    "dotenv": "^17.2.0",
    "googleapis": "^144.0.0",
    "hono": "^4.8.0",
    "ioredis": "^5.8.0",
    "jsonwebtoken": "^9.0.0",
    "prisma": "^6.16.0",
    "xxhash-wasm": "^1.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.16.0",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.37.0",
    "globals": "^16.3.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
