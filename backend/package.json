{
  "name": "ekdrive-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --sourcemap --outfile=dist/index.js",
    "start": "node --enable-source-maps dist/index.js",
    "test": "vitest run",
    "lint": "eslint src/",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../.env.local -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e ../.env.local -- prisma migrate dev",
    "db:studio": "dotenv -e ../.env.local -- prisma studio",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.coverage.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@prisma/client": "^7.10.1",
    "archiver": "^8.0.0",
    "bullmq": "^6.3.16",
    "dotenv": "^18.0.8",
    "googleapis": "^186.0.0",
    "hono": "^4.13.13",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.0",
    "pino": "^10.4.0",
    "prisma": "^7.10.1",
    "sharp": "^0.35.5",
    "xxhash-wasm": "^1.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^8.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
