# ============================================
# EkDrive Environment Variables
# Copy this file to .env.local and fill in values
# ============================================

# --- Neon PostgreSQL ---
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/ekdrive?sslmode=require

# --- Upstash Redis ---
REDIS_URL=https://xxx.upstash.io
REDIS_REST_TOKEN=your_upstash_rest_token

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- JWT & Encryption ---
JWT_SECRET=generate-a-random-256-bit-string
ENCRYPTION_KEY=generate-a-random-256-bit-key

# --- App ---
CORS_ORIGIN=https://app.ekdrive.io
RATE_LIMIT_MAX=100
CHUNK_SIZE_BYTES=52428800