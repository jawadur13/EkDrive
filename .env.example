# ============================================
# EkDrive environment variables
# Copy to .env.local in the repo root and fill in values.
# ============================================

# --- PostgreSQL (e.g. Neon) --- required
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/ekdrive?sslmode=require

# --- Redis for background jobs (health checks, sync, cleanup) --- optional
# Must be a TCP URL. For Upstash use the "rediss://" URL from the console, not the REST URL.
REDIS_URL=rediss://default:your_password@xxx.upstash.io:6379

# --- Google OAuth --- required
# Authorized redirect URI in Google Cloud Console: ${BACKEND_URL}/api/v1/auth/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- Secrets --- required; the backend refuses to start without them
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ENCRYPTION_KEY=
ENCRYPTION_SALT=

# --- App ---
# Frontend and backend must be on the same site so the session cookie is sent.
CORS_ORIGIN=http://localhost:5173
BACKEND_URL=http://localhost:3000
PORT=3000
RATE_LIMIT_MAX=100
CHUNK_SIZE_BYTES=52428800
# Set to true only behind a proxy you control that sets X-Forwarded-For.
TRUST_PROXY=false
